{
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["custom/layout", "custom/caffeine", "network", "bluetooth", "pulseaudio", "battery", "custom/updates", "custom/weather", "clock"],

  "hyprland/workspaces": {
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 80,
    "separate-outputs": true
  },

  "custom/layout": {
    "format": "<span size='13000' foreground='#cba6f7'>󰌌 </span>{}",
    "exec": "~/.config/waybar/scripts/layout.sh",
    "interval": 1,
    "return-type": "json"
  },

  "custom/caffeine": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/caffeine.sh",
    "on-click": "~/.config/waybar/scripts/caffeine.sh --toggle",
    "interval": 86400,
    "return-type": "json"
  },

  "custom/weather": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 1800,
    "return-type": "json"
  },

  "custom/updates": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 3600,
    "return-type": "json"
  }
}
