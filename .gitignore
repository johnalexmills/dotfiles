# Global dotfiles ignores

# Runtime/cache files that shouldn't be tracked
~/.zoxide.nu

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~

# tmux plugins — managed by TPM at runtime, not tracked in git
tmux/.config/tmux/plugins/

# fish — managed by fisher + catppuccin plugin at runtime
fish/.config/fish/fish_variables
fish/.config/fish/themes/
fish/.config/fish/conf.d/fish_frozen_theme.fish
